{
  "type": "hstack",
  "id": "transport",
  "padding": 7,
  "gap": 6,
  "children": [
    { "type": "button", "id": "transport.returnToStart", "text": "|<", "command": "transport.returnToStart", "size": 40 },
    { "type": "button", "id": "transport.play", "text": "Play", "command": "transport.play", "size": 72 },
    { "type": "button", "id": "transport.stop", "text": "Stop", "command": "transport.stop", "size": 72 },
    { "type": "panel", "id": "transport.divider", "size": 1 },
    { "type": "button", "id": "transport.addTrack", "text": "Add Track", "command": "track.add", "size": 96 },
    { "type": "button", "id": "transport.addClip", "text": "Add Clip...", "command": "clip.add", "size": 96 },
    { "type": "hstack", "id": "transport.spacer", "flex": 1 },
    { "type": "button", "id": "transport.undo", "text": "Undo", "command": "edit.undo", "size": 64 },
    { "type": "button", "id": "transport.redo", "text": "Redo", "command": "edit.redo", "size": 64 }
  ]
}
